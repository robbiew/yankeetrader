[
  "/opt/homebrew/bin/dosbox-staging",
  "--noprimaryconf",
  "--nolocalconf",
  "--set",
  "cpu_cycles=200000",
  "--set",
  "nosound=true",
  "-c",
  "mount c /tmp/yt-defender-stock-scratch/one-versus-37-empty/child-1/observed-b",
  "-c",
  "c:",
  "-c",
  "date 11/05/2026",
  "-c",
  "time 00:00:02",
  "-c",
  "date > DOSDATE.LOG",
  "-c",
  "time > DOSTIME.LOG",
  "-c",
  "ytmaint > TRACE.BIN",
  "-c",
  "if errorlevel 1 echo PROGRAM_ERROR > ERROR.LOG",
  "-c",
  "if not errorlevel 1 echo PROGRAM_OK > OK.LOG",
  "-c",
  "echo PROGRAM_RETURNED > RETURN.LOG",
  "-c",
  "date > ENDDATE.LOG",
  "-c",
  "time > ENDTIME.LOG",
  "-c",
  "exit"
]
