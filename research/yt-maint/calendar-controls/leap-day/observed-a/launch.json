[
  "/opt/homebrew/bin/dosbox-staging",
  "--noprimaryconf",
  "--nolocalconf",
  "--set",
  "cpu_cycles=200000",
  "--set",
  "nosound=true",
  "-c",
  "mount c /private/tmp/yt-maint-calendar-native/leap-day-observed-a",
  "-c",
  "c:",
  "-c",
  "date 02/29/2028",
  "-c",
  "time 00:00:00",
  "-c",
  "date > DOSDATE.LOG",
  "-c",
  "time > DOSTIME.LOG",
  "-c",
  "ytmaint > TRACE.BIN",
  "-c",
  "echo PROGRAM_RETURNED > RETURN.LOG",
  "-c",
  "date > ENDDATE.LOG",
  "-c",
  "time > ENDTIME.LOG",
  "-c",
  "exit"
]
