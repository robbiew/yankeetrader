    },
    {
      "descriptor_offset": 147094,
      "text_offset": 147098,
      "length": 16,
      "text": "Z - Instructions",
      "hex": "5a202d20496e737472756374696f6e73"
    },
    {
      "descriptor_offset": 147114,
      "text_offset": 147118,
      "length": 20,
      "text": "+ - Fire Plasma Bolt",
      "hex": "2b202d204669726520506c61736d6120426f6c74"
    },
    {
      "descriptor_offset": 147138,
      "text_offset": 147142,
      "length": 57,
      "text": "String commands by seperating them with a semicolons (;).",
      "hex": "537472696e6720636f6d6d616e64732062792073657065726174696e67207468656d207769746820612073656d69636f6c6f6e7320283b292e"
    },
    {
      "descriptor_offset": 147200,
      "text_offset": 147204,
      "length": 60,
      "text": "To place an EXTRA 'hit enter' in a string, use an extra ';'.",
      "hex": "546f20706c61636520616e204558545241202768697420656e7465722720696e206120737472696e672c2075736520616e20657874726120273b272e"
    },
    {
      "descriptor_offset": 147264,
      "text_offset": 147268,
      "length": 50,
      "text": "Save a command string by placing a '/' at the end.",
      "hex": "53617665206120636f6d6d616e6420737472696e6720627920706c6163696e67206120272f272061742074686520656e642e"
    },
    {
      "descriptor_offset": 147318,
      "text_offset": 147322,
      "length": 49,
      "text": "Then hit Control-R to [R]eplay the saved command.",
      "hex": "5468656e2068697420436f6e74726f6c2d5220746f205b525d65706c61792074686520736176656420636f6d6d616e642e"
    },
    {
      "descriptor_offset": 147372,
      "text_offset": 147376,
      "length": 52,
      "text": "You may repeat any command up to 20 times by putting",
      "hex": "596f75206d61792072657065617420616e7920636f6d6d616e6420757020746f2032302074696d65732062792070757474696e67"
    },
    {
      "descriptor_offset": 147428,
      "text_offset": 147432,
      "length": 54,
      "text": "a /R# at the end of your command. Replace the '#' with",
      "hex": "61202f52232061742074686520656e64206f6620796f757220636f6d6d616e642e205265706c61636520746865202723272077697468"
    },
    {
      "descriptor_offset": 147486,
      "text_offset": 147490,
      "length": 54,
      "text": "any number between 2 and 20. Example: your command/R20",
      "hex": "616e79206e756d626572206265747765656e203220616e642032302e204578616d706c653a20796f757220636f6d6d616e642f523230"
    }
  ]
}
